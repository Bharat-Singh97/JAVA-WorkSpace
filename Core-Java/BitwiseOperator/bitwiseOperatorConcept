Shift Operator

class Example{
	public static void main(String[] args) {
		int x=12;
		int y=3;
		int res=x<<y; // left shift operator   96
		System.out.println(res);	 
	}
}

res  x*2^y  = 12*(2^3) = 12 * 8 = 96 


class Example{
	public static void main(String[] args) {
		int x=24;
		int y=2;
		int res=x>>y; // right shift operator   6
		System.out.println(res);		 
	}
}


res = x/2^y = 24/2^2 = 24/4 = 6

